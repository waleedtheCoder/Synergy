# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
COOKIE_SECRET=change-me-cookie-secret

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://synergi:synergi@localhost:5432/synergi?schema=public

# ── Redis / Queues ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Synergi <hello@synergi.dev>"
# Local dev fallback (SMTP via Mailhog) is used automatically when RESEND_API_KEY is empty.
SMTP_HOST=localhost
SMTP_PORT=1025

# ── AWS S3 ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=synergi-uploads

# ── Search ───────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=synergi_dev_master_key

# ── Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Rate limiting ────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
