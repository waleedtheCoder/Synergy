# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
COOKIE_SECRET=change-me-cookie-secret

# ── Database (Supabase) ─────────────────────────────────────────────────
# From Supabase dashboard → Connect → ORM → Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth / JWT ───────────────────────────────────────────────────────
# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse these example/placeholder values in any real environment.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# 32-byte key (64 hex chars) for encrypting sensitive fields at rest (2FA secrets).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── Email (Resend) ───────────────────────────────────────────────────
# From Resend dashboard → API Keys. Without a verified sending domain, use the
# sandbox sender below (only delivers to your own Resend account email).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Synergi <onboarding@resend.dev>"
# MailDev fallback (SMTP) is used automatically when RESEND_API_KEY is empty.
SMTP_HOST=localhost
SMTP_PORT=1025

# ── File storage (Supabase Storage) ─────────────────────────────────────
# From Supabase dashboard → Settings → API → Project URL / service_role key
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
SUPABASE_STORAGE_BUCKET=uploads

# ── Search ───────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=synergi_dev_master_key

# ── Error tracking (Sentry) ──────────────────────────────────────────
# From Sentry dashboard → Settings → Projects → <project> → Client Keys (DSN)
SENTRY_DSN=

# ── Rate limiting ────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────
# From Cloudflare dashboard → Turnstile → your widget → Secret key.
# Leave empty to disable CAPTCHA verification (e.g. local dev/CI).
TURNSTILE_SECRET_KEY=

# ── AI / RAG features ────────────────────────────────────────────────
# Claude API key from https://platform.claude.com → API keys. Used only for
# answer generation; embeddings run locally (no key). Leave empty to disable
# the AI endpoints (they return 503) while everything else keeps working.
ANTHROPIC_API_KEY=
